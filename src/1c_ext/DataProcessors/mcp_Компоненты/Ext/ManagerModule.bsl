#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаПараметров()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяМакета", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("БезопасныйРежим", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

Процедура ДобавитьПараметры(Параметры, ИмяМакета, БезопасныйРежим, Описание)

	Строка = Параметры.Добавить();
	Строка.ИмяМакета = ИмяМакета;
	Строка.БезопасныйРежим = БезопасныйРежим;
	Строка.Описание = Описание;

КонецПроцедуры

Функция НоваяТаблицаКомпонентов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяМакета", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВерсияПоставки", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВерсияУстановленная", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Установлен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Активен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПримененВСеансе", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Сторонний", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("БезопасныйРежим", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

Функция НовыйРезультат(Имя, Версия)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ТребуетсяПерезапуск", Ложь);
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Версия", Версия);

	Возврат Результат;

КонецФункции

// Двоичные макеты этой обработки — по одному на поставляемый компонент.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных
//
Функция ДвоичныеМакеты()

	Макеты = Новый Массив;
	Для Каждого Макет Из Метаданные.Обработки.mcp_Компоненты.Макеты Цикл
		Если Макет.ТипМакета = Метаданные.СвойстваОбъектов.ТипМакета.ДвоичныеДанные Тогда
			Макеты.Добавить(Макет);
		КонецЕсли;
	КонецЦикла;

	Возврат Макеты;

КонецФункции

// Имя, синоним и версия расширения из файла .cfe — без установки.
//
// Параметры:
//  Данные - ДвоичныеДанные - файл .cfe
//
// Возвращаемое значение:
//  Структура - Имя, Синоним, Версия
//
Функция ОписаниеИзДанных(Данные)

	Расширение = РасширенияКонфигурации.Создать(Данные);

	Описание = Новый Структура;
	Описание.Вставить("Имя", Расширение.Имя);
	Описание.Вставить("Синоним", ?(ПустаяСтрока(Расширение.Синоним), Расширение.Имя, Расширение.Синоним));
	Описание.Вставить("Версия", Расширение.Версия);

	Возврат Описание;

КонецФункции

// Возвращаемое значение:
//  Соответствие - имя расширения → РасширениеКонфигурации
//
Функция УстановленныеРасширения()

	Установленные = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Установленные.Вставить(Расширение.Имя, Расширение);
	КонецЦикла;

	Возврат Установленные;

КонецФункции

// Расширения, объекты которых видны в метаданных текущего сеанса. Признак — корневая подсистема
// расширения (у компонента по контракту она есть). Записанное в этом сеансе расширение сюда не попадает.
//
// Возвращаемое значение:
//  Соответствие - имя расширения → Истина
//
Функция ИменаРасширенийПримененныхВСеансе()

	Имена = Новый Соответствие;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Расширение = Подсистема.РасширениеКонфигурации();
		Если Расширение <> Неопределено Тогда
			Имена.Вставить(Расширение.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Имена расширений, у которых есть корневая подсистема с "mcp_MCPСервер" в имени, — компоненты
// по контракту, в том числе не из нашей поставки.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаРасширенийКомпонентовПоПодсистемам()

	Имена = Новый Массив;
	Для Каждого Подсистема Из mcp_Метаданные.ПереопределяемыеКорневыеПодсистемы() Цикл
		Расширение = Подсистема.РасширениеКонфигурации();
		Если Расширение <> Неопределено И Имена.Найти(Расширение.Имя) = Неопределено Тогда
			Имена.Добавить(Расширение.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

Функция ИмяСвоегоРасширения()

	Расширение = Метаданные.Обработки.mcp_Компоненты.РасширениеКонфигурации();
	Возврат ?(Расширение = Неопределено, "", Расширение.Имя);

КонецФункции

// Заполняет по строке компонента сведения об установке и вычисляет состояние.
Процедура ЗаполнитьСведенияОбУстановке(Строка, Установленные, ПримененныеВСеансе)

	Расширение = Установленные[Строка.Имя];
	Строка.Установлен = Расширение <> Неопределено;
	Если НЕ Строка.Установлен Тогда
		Строка.Состояние = СостояниеНеУстановлен();
		Возврат;
	КонецЕсли;

	Строка.ВерсияУстановленная = Расширение.Версия;
	Строка.Активен = Расширение.Активно;
	Строка.ПримененВСеансе = ПримененныеВСеансе[Строка.Имя] = Истина;

	Если Строка.Сторонний Тогда
		Строка.Состояние = СостояниеСторонний();
	ИначеЕсли НЕ Строка.ПримененВСеансе И Строка.Активен Тогда
		Строка.Состояние = СостояниеТребуетПерезапуска();
	ИначеЕсли НЕ Строка.Активен Тогда
		Строка.Состояние = СостояниеОтключен();
	Иначе
		Сравнение = mcp_ОбщегоНазначения.СравнитьВерсии(Строка.ВерсияПоставки, Строка.ВерсияУстановленная);
		Если Сравнение > 0 Тогда
			Строка.Состояние = СостояниеЕстьОбновление();
		ИначеЕсли Сравнение < 0 Тогда
			Строка.Состояние = СостояниеУстановленаНовее();
		Иначе
			Строка.Состояние = СостояниеАктивен();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция БезопасныйРежимКомпонента(ИмяМакета)

	СтрокаПараметров = ПараметрыКомпонентов().Найти(ИмяМакета, "ИмяМакета");
	Возврат ?(СтрокаПараметров = Неопределено, Истина, СтрокаПараметров.БезопасныйРежим);

КонецФункции

// Предупреждения о небезопасных действиях при установке из кода не нужны; свойство есть не во всех
// режимах совместимости, поэтому в Попытке.
Процедура ОтключитьПредупрежденияОбОпасныхДействиях(Расширение)

	Попытка
		Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОНебезопасныхДействиях = Ложь;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
