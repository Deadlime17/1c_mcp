// Поставка компонентов MCP-сервера.
//
// Компонент — отдельное расширение конфигурации со своими инструментами (см. docs/kb/Компоненты_MCP_сервера.md).
// Поставляемые компоненты лежат в этой обработке двоичными макетами: один макет = один файл .cfe.
// Имя, синоним и версия компонента читаются из самого файла (РасширенияКонфигурации.Создать(Данные)),
// в макете ничего дублировать не нужно. Параметры, которых в .cfe нет (безопасный режим, описание), —
// в функции ПараметрыКомпонентов.
//
// Вся логика здесь, чтобы её можно было проверять программно; форма управления сервером только
// вызывает этот API и показывает результат.

#Область ПрограммныйИнтерфейс

// Параметры поставляемых компонентов, которых нет в файле .cfe.
// Единственное место, которое правится при добавлении компонента (кроме самого макета).
// Макет без строки здесь получает значения по умолчанию: безопасный режим включён, описание пустое.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ИмяМакета - Строка - имя двоичного макета этой обработки
//   * БезопасныйРежим - Булево - с каким безопасным режимом устанавливать расширение
//   * Описание - Строка - что делает компонент, для вкладки «Компоненты»
//
Функция ПараметрыКомпонентов() Экспорт

	Параметры = НоваяТаблицаПараметров();

	ДобавитьПараметры(Параметры, "MCP_СправкаПлатформы", Ложь,
		"Поиск по справке синтакс-помощника платформы: глобальные функции, типы, методы, свойства,"
		+ " события, таблицы запросов, операторы языка. Инструменты platform_help (поиск и карточки)"
		+ " и platform_help_index (сборка индекса из shcntx_ru.hbk сервера).");

	ДобавитьПараметры(Параметры, "MCP_СтруктураБД", Истина,
		"Соответствие метаданных 1С и таблиц базы данных: имена таблиц и полей СУБД для объектов"
		+ " конфигурации. Инструменты db_tables и db_table_fields.");

	Возврат Параметры;

КонецФункции

// Список компонентов: поставляемые в макетах плюс установленные сторонние.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ИмяМакета - Строка - имя макета; пусто у стороннего компонента
//   * Имя - Строка - имя расширения
//   * Синоним - Строка - синоним расширения (название компонента)
//   * Описание - Строка - из ПараметрыКомпонентов
//   * ВерсияПоставки - Строка - версия в макете; пусто у стороннего
//   * ВерсияУстановленная - Строка - версия установленного расширения; пусто, если не установлен
//   * Установлен - Булево
//   * Активен - Булево - свойство Активно установленного расширения
//   * ПримененВСеансе - Булево - объекты расширения видны в метаданных текущего сеанса
//   * Сторонний - Булево - установлен, найден по подсистеме, макета нет
//   * БезопасныйРежим - Булево - из ПараметрыКомпонентов (для поставляемых)
//   * Состояние - Строка - см. СостояниеНеУстановлен и далее
//
Функция Компоненты() Экспорт

	Компоненты = НоваяТаблицаКомпонентов();
	Установленные = УстановленныеРасширения();
	ПримененныеВСеансе = ИменаРасширенийПримененныхВСеансе();
	Параметры = ПараметрыКомпонентов();

	Для Каждого Макет Из ДвоичныеМакеты() Цикл
		Строка = Компоненты.Добавить();
		Строка.ИмяМакета = Макет.Имя;
		Описание = ОписаниеИзДанных(ПолучитьМакет(Макет.Имя));
		Строка.Имя = Описание.Имя;
		Строка.Синоним = Описание.Синоним;
		Строка.ВерсияПоставки = Описание.Версия;
		СтрокаПараметров = Параметры.Найти(Макет.Имя, "ИмяМакета");
		Если СтрокаПараметров <> Неопределено Тогда
			Строка.Описание = СтрокаПараметров.Описание;
			Строка.БезопасныйРежим = СтрокаПараметров.БезопасныйРежим;
		Иначе
			Строка.БезопасныйРежим = Истина;
		КонецЕсли;
		ЗаполнитьСведенияОбУстановке(Строка, Установленные, ПримененныеВСеансе);
	КонецЦикла;

	СвоеРасширение = ИмяСвоегоРасширения();
	Для Каждого ИмяРасширения Из ИменаРасширенийКомпонентовПоПодсистемам() Цикл
		Если ИмяРасширения = СвоеРасширение Или Компоненты.Найти(ИмяРасширения, "Имя") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Расширение = Установленные[ИмяРасширения];
		Строка = Компоненты.Добавить();
		Строка.Имя = ИмяРасширения;
		Строка.Синоним = ?(Расширение = Неопределено, ИмяРасширения, Расширение.Синоним);
		Строка.Сторонний = Истина;
		ЗаполнитьСведенияОбУстановке(Строка, Установленные, ПримененныеВСеансе);
	КонецЦикла;

	Возврат Компоненты;

КонецФункции

// Проверяет возможность установки компонента из макета без записи в базу.
//
// Параметры:
//  ИмяМакета - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - проблем нет
//   * Имя, Версия - Строка - из файла
//   * ИзменяетСтруктуруДанных - Булево - установка потребует реструктуризации (создания таблиц)
//   * Проблемы - Массив из Строка - описания проблем применения
//   * Сообщение - Строка - текст для пользователя
//
Функция ПроверитьКомпонент(Знач ИмяМакета) Экспорт

	Данные = ПолучитьМакет(ИмяМакета);
	Описание = ОписаниеИзДанных(Данные);

	// Установленный ранее компонент проверяется как обновление того же объекта,
	// иначе платформа сообщит о совпадении имени и идентификаторов с ним же
	Расширение = УстановленныеРасширения()[Описание.Имя];
	ЭтоОбновление = Расширение <> Неопределено;
	Если НЕ ЭтоОбновление Тогда
		Расширение = РасширенияКонфигурации.Создать(Данные);
		Расширение.ОбластьДействия = ОбластьДействияРасширенияКонфигурации.ИнформационнаяБаза;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Описание.Имя);
	Результат.Вставить("Версия", Описание.Версия);
	Результат.Вставить("ИзменяетСтруктуруДанных", Расширение.ИзменяетСтруктуруДанных());

	Проблемы = Новый Массив;
	Для Каждого Проблема Из Расширение.ПроверитьВозможностьПрименения(Данные) Цикл
		Проблемы.Добавить(Проблема.Описание);
	КонецЦикла;
	Результат.Вставить("Проблемы", Проблемы);
	Результат.Вставить("Успех", Проблемы.Количество() = 0);

	Если Проблемы.Количество() = 0 Тогда
		Сообщение = СтрШаблон("Компонент %1 версии %2 можно установить.", Описание.Имя, Описание.Версия);
	Иначе
		Сообщение = СтрШаблон("Компонент %1 версии %2 установить нельзя:%3%4", Описание.Имя, Описание.Версия,
			Символы.ПС, СтрСоединить(Проблемы, Символы.ПС));
	КонецЕсли;
	Если Результат.ИзменяетСтруктуруДанных И НЕ ЭтоОбновление Тогда
		Сообщение = Сообщение + Символы.ПС + "Установка создаёт таблицы в базе; применяется после перезапуска сеанса.";
	КонецЕсли;
	Результат.Вставить("Сообщение", Сообщение);

	Возврат Результат;

КонецФункции

// Устанавливает компонент из макета или обновляет уже установленный тем же именем.
// Новому расширению задаются область действия «Информационная база» и безопасный режим из
// ПараметрыКомпонентов; у обновляемого эти свойства сохраняются. Объекты компонента становятся
// доступны в новых сеансах — текущий надо перезапустить.
//
// Параметры:
//  ИмяМакета - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Сообщение - Строка - текст для пользователя
//   * ТребуетсяПерезапуск - Булево - Истина при успехе
//   * Имя, Версия - Строка - установленного компонента
//
Функция УстановитьКомпонент(Знач ИмяМакета) Экспорт

	Данные = ПолучитьМакет(ИмяМакета);
	Описание = ОписаниеИзДанных(Данные);
	Результат = НовыйРезультат(Описание.Имя, Описание.Версия);

	Существующее = УстановленныеРасширения()[Описание.Имя];
	Если Существующее = Неопределено Тогда
		Расширение = РасширенияКонфигурации.Создать(Данные);
		Расширение.ОбластьДействия = ОбластьДействияРасширенияКонфигурации.ИнформационнаяБаза;
		Расширение.БезопасныйРежим = БезопасныйРежимКомпонента(ИмяМакета);
		// «Из коробки» инструменты компонента доступны всем: основные роли расширения действуют
		// на всех пользователей. Кому нужна настройка прав — снимает флаг и выдаёт роли (решение владельца 2026-09-28).
		Расширение.ИспользоватьОсновныеРолиДляВсехПользователей = Истина;
		ОтключитьПредупрежденияОбОпасныхДействиях(Расширение);
		Действие = "установлен";
	Иначе
		Расширение = Существующее;
		Действие = "обновлён с версии " + Существующее.Версия;
	КонецЕсли;

	Попытка
		Расширение.Записать(Данные);
	Исключение
		Результат.Сообщение = СтрШаблон("Не удалось установить компонент %1: %2", Описание.Имя, ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.ТребуетсяПерезапуск = Истина;
	Результат.Сообщение = СтрШаблон("Компонент %1 (%2) %3. Чтобы изменения вступили в силу, перезапустите сеанс.",
		Описание.Синоним, Описание.Версия, Действие);

	Возврат Результат;

КонецФункции

// Включает или отключает установленный компонент (свойство Активно расширения).
//
// Параметры:
//  Имя - Строка - имя расширения
//  Активно - Булево
//
// Возвращаемое значение:
//  Структура - как у УстановитьКомпонент
//
Функция УстановитьАктивность(Знач Имя, Знач Активно) Экспорт

	Расширение = УстановленныеРасширения()[Имя];
	Если Расширение = Неопределено Тогда
		Результат = НовыйРезультат(Имя, "");
		Результат.Сообщение = СтрШаблон("Расширение %1 не установлено.", Имя);
		Возврат Результат;
	КонецЕсли;

	Результат = НовыйРезультат(Имя, Расширение.Версия);
	Если Расширение.Активно = Активно Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон("Компонент %1 уже %2.", Имя, ?(Активно, "включён", "отключён"));
		Возврат Результат;
	КонецЕсли;

	Попытка
		Расширение.Активно = Активно;
		Расширение.Записать(Расширение.ПолучитьДанные());
	Исключение
		Результат.Сообщение = СтрШаблон("Не удалось %1 компонент %2: %3",
			?(Активно, "включить", "отключить"), Имя, ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.ТребуетсяПерезапуск = Истина;
	Результат.Сообщение = СтрШаблон("Компонент %1 %2. Чтобы изменения вступили в силу, перезапустите сеанс.",
		Имя, ?(Активно, "включён", "отключён"));

	Возврат Результат;

КонецФункции

